{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "@openforge/shared": ["../shared/src"],
      "@openforge/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src"]
}
