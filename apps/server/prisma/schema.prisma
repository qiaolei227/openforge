generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled
}

enum OrgStatus {
  active
  disabled
}

enum UserIdentity {
  user
  designer
  admin
}

model SysUser {
  id           String       @id @default(uuid()) @db.Uuid
  username     String       @unique @db.VarChar(50)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  displayName  String       @map("display_name") @db.VarChar(100)
  email        String?      @db.VarChar(255)
  phone        String?      @db.VarChar(20)
  avatar       String?      @db.VarChar(500)
  status       UserStatus   @default(active)
  identity     UserIdentity @default(user)
  isAdmin      Boolean      @default(false) @map("is_admin")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  userOrgs    SysUserOrg[]
  userRoles   SysUserRole[]
  createdApps SysApp[]     @relation("AppCreator")

  @@map("sys_user")
}

model SysOrganization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(50)
  parentId  String?   @map("parent_id") @db.Uuid
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  parent   SysOrganization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children SysOrganization[] @relation("OrgHierarchy")
  userOrgs SysUserOrg[]

  @@map("sys_organization")
}

model SysUserOrg {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  orgId     String  @map("org_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")

  user SysUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  SysOrganization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("sys_user_org")
}

// ── 系统参数 ──
model SysConfig {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(100)
  name       String   @db.VarChar(200)
  value      String?  @db.Text
  defaultVal String?  @map("default_val") @db.Text
  description String? @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sys_config")
}

model SysApp {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  icon        String?  @db.VarChar(50)
  description String?  @db.Text
  version     String?  @db.VarChar(20)
  themeColor  String?  @map("theme_color") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  creator SysUser?   @relation("AppCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  models  SysModel[]
  dicts   SysDict[]
  menus   SysMenu[]  @relation("AppMenus")

  @@map("sys_app")
}

model SysDict {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @map("app_id") @db.Uuid
  code        String   @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  app   SysApp       @relation(fields: [appId], references: [id])
  items SysDictItem[]

  @@unique([appId, code])
  @@map("sys_dict")
}

model SysDictItem {
  id        String   @id @default(uuid()) @db.Uuid
  dictId    String   @map("dict_id") @db.Uuid
  value     String   @db.VarChar(100)
  label     String   @db.VarChar(100)
  labelEn   String?  @map("label_en") @db.VarChar(100)
  color     String?  @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dict SysDict @relation(fields: [dictId], references: [id], onDelete: Cascade)

  @@unique([dictId, value])
  @@map("sys_dict_item")
}

model SysModel {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @map("app_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(100)
  tableName   String   @map("table_name") @db.VarChar(200)
  description String?  @db.Text
  dataScope        String   @default("private") @map("data_scope") @db.VarChar(20)
  isTree           Boolean  @default(false) @map("is_tree")
  enableDataStatus Boolean  @default(false) @map("enable_data_status")
  semantic         String?  @db.Text
  aiHint      String?  @map("ai_hint") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  app                  SysApp                  @relation(fields: [appId], references: [id])
  fields               SysField[]
  views                SysView[]
  entities             SysEntity[]
  distributionPolicies SysDistributionPolicy[]
  fieldPermissions     SysFieldPermission[]
  menuTargets          SysMenu[]               @relation("MenuTargetModel")
  actions              SysAction[]

  @@unique([appId, code])
  @@unique([tableName])
  @@map("sys_model")
}

model SysEntity {
  id         String   @id @default(uuid()) @db.Uuid
  modelId    String   @map("model_id") @db.Uuid
  name       String   @db.VarChar(100)
  code       String   @db.VarChar(100)
  tableName  String   @map("table_name") @db.VarChar(200)
  entityType String   @map("entity_type") @db.VarChar(20)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model  SysModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fields SysField[]

  @@unique([modelId, code])
  @@unique([tableName])
  @@map("sys_entity")
}

model SysField {
  id                String    @id @default(uuid()) @db.Uuid
  modelId           String    @map("model_id") @db.Uuid
  entityId          String?   @map("entity_id") @db.Uuid
  name              String    @db.VarChar(100)
  columnName        String    @map("column_name") @db.VarChar(100)
  fieldType         String    @map("field_type") @db.VarChar(30)
  isRequired        Boolean   @default(false) @map("is_required")
  isUnique          Boolean   @default(false) @map("is_unique")
  defaultValue      Json?     @map("default_value")
  options           Json?
  sortOrder         Int       @default(0) @map("sort_order")
  isSystem          Boolean   @default(false) @map("is_system")
  semantic          String?   @db.Text
  aiHint            String?   @map("ai_hint") @db.Text
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedColumnName String?   @map("deleted_column_name") @db.VarChar(200)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  model              SysModel                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  entity             SysEntity?              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  distributionPolicy SysDistributionPolicy[]
  fieldPermissions   SysFieldPermission[]

  @@unique([modelId, entityId, columnName])
  @@map("sys_field")
}

model SysDistributionPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  editable  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model SysModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  field SysField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([modelId, fieldId])
  @@map("sys_distribution_policy")
}

model SysView {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(20)
  layout    Json     @db.JsonB
  config         Json?    @db.JsonB
  isDefault      Boolean  @default(false) @map("is_default")
  visibleActions String[] @default([]) @map("visible_actions") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model       SysModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  menuTargets SysMenu[] @relation("MenuTargetView")

  @@map("sys_view")
}

model SysAction {
  id          String   @id @default(uuid()) @db.Uuid
  modelId     String   @map("model_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  icon        String?  @db.VarChar(50)
  category    String   @default("system") @db.VarChar(20)
  actionType  String   @default("builtin") @map("action_type") @db.VarChar(20)
  displayType String   @default("button") @map("display_type") @db.VarChar(20)
  position    String   @default("both") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  config      Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model    SysModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parent   SysAction?  @relation("ActionHierarchy", fields: [parentId], references: [id])
  children SysAction[] @relation("ActionHierarchy")

  @@unique([modelId, code])
  @@index([modelId])
  @@map("sys_action")
}

model SysFile {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  originalName  String   @map("original_name") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  size          BigInt
  storageKey    String   @map("storage_key") @db.VarChar(500)
  uploadedBy    String   @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([orgId])
  @@map("sys_file")
}

// ── P2.1 RBAC ──

model SysRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles        SysUserRole[]
  roleMenus        SysRoleMenu[]
  rolePermissions  SysRolePermission[]
  fieldPermissions SysFieldPermission[]

  @@map("sys_role")
}

model SysUserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("sys_user_role")
}

model SysMenu {
  id                  String   @id @default(uuid()) @db.Uuid
  appId               String   @map("app_id") @db.Uuid
  parentId            String?  @map("parent_id") @db.Uuid
  code                String   @db.VarChar(100)
  type                String   @db.VarChar(20)
  name                String   @db.VarChar(100)
  icon                String?  @db.VarChar(50)
  sortOrder           Int      @default(0) @map("sort_order")
  visible             Boolean  @default(true)
  targetModelId       String?  @map("target_model_id") @db.Uuid
  targetViewType      String?  @map("target_view_type") @db.VarChar(20)
  targetViewId        String?  @map("target_view_id") @db.Uuid
  targetUrl           String?  @map("target_url") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  app          SysApp    @relation("AppMenus", fields: [appId], references: [id], onDelete: Cascade)
  parent       SysMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children     SysMenu[] @relation("MenuHierarchy")
  targetModel  SysModel? @relation("MenuTargetModel", fields: [targetModelId], references: [id], onDelete: Restrict)
  targetView   SysView?  @relation("MenuTargetView", fields: [targetViewId], references: [id], onDelete: Restrict)
  roleMenus    SysRoleMenu[]

  @@unique([appId, code])
  @@index([appId])
  @@index([parentId])
  @@index([type])
  @@map("sys_menu")
}

model SysRoleMenu {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  menuId      String   @map("menu_id") @db.Uuid
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu SysMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@index([roleId])
  @@map("sys_role_menu")
}

model SysFieldPermission {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  access    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  role  SysRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  model SysModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  field SysField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([roleId, fieldId])
  @@index([roleId])
  @@index([modelId])
  @@index([fieldId])
  @@map("sys_field_permission")
}

model SysRolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String   @db.VarChar(100)
  actions   String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@index([roleId])
  @@map("sys_role_permission")
}
